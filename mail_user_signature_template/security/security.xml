<odoo>
    <!-- Categories -->
    <record id="module_category_signature_template" model="ir.module.category">
        <field name="name">Signature Templates</field>
        <field name="description">Manage email signature templates</field>
        <field name="sequence">100</field>
    </record>

    <!-- Privilege (v19 requirement: bridge between category and groups) -->
    <record id="privilege_signature_template" model="res.groups.privilege">
        <field name="name">Signature Templates</field>
        <field name="category_id" ref="module_category_signature_template" />
        <field name="sequence">1</field>
    </record>

    <!-- Groups -->
    <record id="group_signature_template_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_signature_template" />
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
        <field name="comment">Can view and use signature templates</field>
    </record>

    <record id="group_signature_template_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_signature_template" />
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('group_signature_template_user'))]" />
        <field name="comment">Can create and manage signature templates</field>
        <field
            name="user_ids"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
    </record>

    <!-- Record Rules -->
    <!-- Users can only see templates from their company -->
    <record id="signature_template_company_rule" model="ir.rule">
        <field name="name">Signature Template: Company Rule</field>
        <field name="model_id" ref="model_signature_template" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
    </record>

    <!-- Users can only see their own per-company signature settings -->
    <record id="user_signature_company_own_rule" model="ir.rule">
        <field name="name">Per-Company Signature: Own Records</field>
        <field name="model_id" ref="model_user_signature_company" />
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
    </record>

    <!-- Admins can see all per-company signature settings -->
    <record id="user_signature_company_admin_rule" model="ir.rule">
        <field name="name">Per-Company Signature: Admin Access</field>
        <field name="model_id" ref="model_user_signature_company" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field
            name="groups"
            eval="[(4, ref('base.group_system')), (4, ref('group_signature_template_manager'))]"
        />
    </record>
</odoo>
